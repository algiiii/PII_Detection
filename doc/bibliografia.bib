@online{ondevice2025systematic,
  title = {A {{Systematic Evaluation}} of {{On-Device LLMs}}: {{Quantization}}, {{Performance}}, and {{Resources}}},
  shorttitle = {A {{Systematic Evaluation}} of {{On-Device LLMs}}},
  author = {Song, Qingyu and Liu, Rui and Lin, Wei and Liao, Peiyu and Zhao, Wenqian and Wang, Yiwen and Hu, Shoubo and Jiang, Yining and Long, Mochun and Zhen, Hui-Ling and Jiang, Ning and Yuan, Mingxuan and Xiang, Qiao and Xu, Hong},
  date = {2026-03-16},
  eprint = {2505.15030},
  eprinttype = {arXiv},
  eprintclass = {cs.LG},
  doi = {10.48550/arXiv.2505.15030},
  url = {http://arxiv.org/abs/2505.15030},
  urldate = {2026-07-18},
  abstract = {Deploying Large Language Models (LLMs) on edge devices enhances privacy but faces performance hurdles due to limited resources. We introduce a systematic methodology to evaluate on-device LLMs, balancing capability, efficiency, and resource constraints. Through an extensive analysis of models (0.5B-14B) and seven post-training quantization (PTQ) methods on commodity hardware, we demonstrate that: 1) Heavily quantized large models consistently outperform smaller, high-precision models, with a performance threshold at \textasciitilde 3.5 effective bits-per-weight (BPW); 2) Resource utilization scales linearly with BPW, though power and memory footprints vary by quantization algorithm; and 3) With a reduction in model size, the primary constraint on throughput transitions from communication overhead to computational latency. We conclude by offering guidelines for optimizing LLMs in resource-constrained edge environments. Our codebase is available at https://anonymous.4open.science/r/LLMOnDevice/.},
  pubstate = {prepublished},
  keywords = {Computer Science - Machine Learning}
}

